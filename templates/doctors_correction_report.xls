   <Row ss:Height="32">
    <Cell ss:MergeAcross="10" ss:StyleID="TitleHeader">
     <Data ss:Type="String">اللجنة العليا للمسؤولية الطبية — بيان السجلات المعادة للموظف للتصحيح والتدقيق</Data>
    </Cell>
   </Row>
   
   <Row ss:Height="22">
    <Cell ss:MergeAcross="10" ss:StyleID="SubTitleHeader">
     <Data ss:Type="String">إجمالي السجلات المطلوب مراجعتها وتصحيحها: (18) سجل — يرجى استيفاء وتصحيح البيانات المبينة قرين كل سجل لإعادة اعتمادها</Data>
    </Cell>
   </Row>
   
   <Row ss:Height="28">
    <Cell ss:StyleID="ColHeader"><Data ss:Type="String">م</Data></Cell>
    <Cell ss:StyleID="ColHeader"><Data ss:Type="String">السطر الأصلي</Data></Cell>
    <Cell ss:StyleID="ColHeader"><Data ss:Type="String">اسم اللجنة الفرعية</Data></Cell>
    <Cell ss:StyleID="ColHeader"><Data ss:Type="String">اسم الطبيب الاستشاري</Data></Cell>
    <Cell ss:StyleID="ColHeader"><Data ss:Type="String">اللقب العلمي</Data></Cell>
    <Cell ss:StyleID="ColHeader"><Data ss:Type="String">التخصص الطبي المعياري</Data></Cell>
    <Cell ss:StyleID="ColHeader"><Data ss:Type="String">جهة العمل / المستشفى</Data></Cell>
    <Cell ss:StyleID="ColHeader"><Data ss:Type="String">الرقم القومي</Data></Cell>
    <Cell ss:StyleID="ColHeader"><Data ss:Type="String">نوع الملاحظة</Data></Cell>
    <Cell ss:StyleID="ColHeader"><Data ss:Type="String">سبب إعادة السجل للمراجعة والتدقيق</Data></Cell>
    <Cell ss:StyleID="ColHeader"><Data ss:Type="String">الإجراء المطلوب من الموظف</Data></Cell>
   </Row>
