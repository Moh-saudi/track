    <Cell ss:StyleID="SampleDataCellCenter"><Data ss:Type="String">أمراض النساء والتوليد</Data></Cell>
    <Cell ss:StyleID="SampleDataCell"><Data ss:Type="String">مستشفيات جامعة الزقازيق</Data></Cell>
    <Cell ss:StyleID="SampleDataCellCenter"><Data ss:Type="String">27811200109012</Data></Cell>
    <Cell ss:StyleID="SampleDataCellCenter"><Data ss:Type="String">01234567890</Data></Cell>
    <Cell ss:StyleID="SampleDataCellCenter"><Data ss:Type="String">فيزا مرتبات</Data></Cell>
    <Cell ss:StyleID="SampleDataCell"><Data ss:Type="String">بنك القاهرة</Data></Cell>
    <Cell ss:StyleID="SampleDataCellCenter"><Data ss:Type="String">5378223344556677</Data></Cell>
    <Cell ss:StyleID="SampleDataCellCenter"><Data ss:Type="String"></Data></Cell>
    <Cell ss:StyleID="SampleDataCellCenter"><Data ss:Type="String"></Data></Cell>
    <Cell ss:StyleID="SampleDataCell"><Data ss:Type="String">خبير مناظير الرحم والحقن المجهري</Data></Cell>
   </Row>
   <Row ss:Height="25">
    <Cell ss:StyleID="SampleDataCell"><Data ss:Type="String">كلية طب جامعة الإسكندرية</Data></Cell>
    <Cell ss:StyleID="SampleDataCell"><Data ss:Type="String">سامح فاروق مصطفى الخولي</Data></Cell>
    <Cell ss:StyleID="SampleDataCellCenter"><Data ss:Type="String">استشاري</Data></Cell>
    <Cell ss:StyleID="SampleDataCellCenter"><Data ss:Type="String">جراحة عظام وكسور</Data></Cell>
    <Cell ss:StyleID="SampleDataCell"><Data ss:Type="String">المستشفى الرئيسي الجامعي بالإسكندرية</Data></Cell>
    <Cell ss:StyleID="SampleDataCellCenter"><Data ss:Type="String">28003040103456</Data></Cell>
    <Cell ss:StyleID="SampleDataCellCenter"><Data ss:Type="String">01098765432</Data></Cell>
    <Cell ss:StyleID="SampleDataCellCenter"><Data ss:Type="String">كارت ميزة</Data></Cell>
    <Cell ss:StyleID="SampleDataCell"><Data ss:Type="String">البنك الأهلي المصري</Data></Cell>
    <Cell ss:StyleID="SampleDataCellCenter"><Data ss:Type="String">6038112233445566</Data></Cell>
    <Cell ss:StyleID="SampleDataCellCenter"><Data ss:Type="String"></Data></Cell>
    <Cell ss:StyleID="SampleDataCellCenter"><Data ss:Type="String"></Data></Cell>
    <Cell ss:StyleID="SampleDataCell"><Data ss:Type="String">استشاري جراحة المفاصل الصناعية والإصابات الرياضية</Data></Cell>
   </Row>
   <Row ss:Height="25">
    <Cell ss:StyleID="SampleDataCell"><Data ss:Type="String">الهيئة العامة للمستشفيات والمعاهد التعليمية</Data></Cell>
    <Cell ss:StyleID="SampleDataCell"><Data ss:Type="String">ياسر كمال حسن عبد الله</Data></Cell>
    <Cell ss:StyleID="SampleDataCellCenter"><Data ss:Type="String">استشاري زميل</Data></Cell>
    <Cell ss:StyleID="SampleDataCellCenter"><Data ss:Type="String">أمراض القلب والأوعية الدموية</Data></Cell>
    <Cell ss:StyleID="SampleDataCell"><Data ss:Type="String">معهد القلب القومي بإمبابة</Data></Cell>
    <Cell ss:StyleID="SampleDataCellCenter"><Data ss:Type="String">27608100107890</Data></Cell>
    <Cell ss:StyleID="SampleDataCellCenter"><Data ss:Type="String">01551234567</Data></Cell>
    <Cell ss:StyleID="SampleDataCellCenter"><Data ss:Type="String">حساب بنكي</Data></Cell>
