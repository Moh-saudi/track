<?xml version="1.0" encoding="UTF-8"?>
<?mso-application progid="Excel.Sheet"?>
<Workbook xmlns="urn:schemas-microsoft-com:office:spreadsheet"
 xmlns:o="urn:schemas-microsoft-com:office:office"
 xmlns:x="urn:schemas-microsoft-com:office:excel"
 xmlns:ss="urn:schemas-microsoft-com:office:spreadsheet"
 xmlns:html="http://www.w3.org/TR/REC-html40">
 <DocumentProperties xmlns="urn:schemas-microsoft-com:office:office">
  <Title>نموذج حصر وتسجيل أطباء واستشاريي اللجان الفرعية</Title>
  <Subject>اللجنة العليا للمسؤولية الطبية وسلامة المريض</Subject>
  <Author>رئاسة مجلس الوزراء - جمهورية مصر العربية</Author>
 </DocumentProperties>
 <Styles>
  <Style ss:ID="Default" ss:Name="Normal">
   <Alignment ss:Vertical="Center" ss:ReadingOrder="RightToLeft"/>
   <Borders/>
   <Font ss:FontName="Segoe UI" ss:Size="10" ss:Color="#1E293B"/>
  </Style>
  <Style ss:ID="TitleHeader">
   <Alignment ss:Horizontal="Center" ss:Vertical="Center"/>
   <Borders>
    <Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="2" ss:Color="#0F766E"/>
   </Borders>
   <Font ss:FontName="Segoe UI" ss:Size="14" ss:Color="#FFFFFF" ss:Bold="1"/>
   <Interior ss:Color="#0F766E" ss:Pattern="Solid"/>
  </Style>
  <Style ss:ID="SubTitleHeader">
   <Alignment ss:Horizontal="Center" ss:Vertical="Center"/>
   <Font ss:FontName="Segoe UI" ss:Size="11" ss:Color="#0F766E" ss:Bold="1"/>
   <Interior ss:Color="#CCFBF1" ss:Pattern="Solid"/>
  </Style>
  <Style ss:ID="ColHeader">
   <Alignment ss:Horizontal="Center" ss:Vertical="Center" ss:WrapText="1"/>
   <Borders>
    <Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="2" ss:Color="#0D9488"/>
    <Border ss:Position="Left" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#CBD5E1"/>
    <Border ss:Position="Right" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#CBD5E1"/>
    <Border ss:Position="Top" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#CBD5E1"/>
   </Borders>
   <Font ss:FontName="Segoe UI" ss:Size="10" ss:Color="#FFFFFF" ss:Bold="1"/>
   <Interior ss:Color="#134E4A" ss:Pattern="Solid"/>
  </Style>
  <Style ss:ID="DataCell">
   <Alignment ss:Horizontal="Right" ss:Vertical="Center"/>
   <Borders>
    <Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
    <Border ss:Position="Left" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
    <Border ss:Position="Right" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
    <Border ss:Position="Top" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
   </Borders>
   <Font ss:FontName="Segoe UI" ss:Size="9.5" ss:Color="#1E293B"/>
  </Style>
  <Style ss:ID="DataCellCenter">
   <Alignment ss:Horizontal="Center" ss:Vertical="Center"/>
   <Borders>
    <Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
    <Border ss:Position="Left" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
    <Border ss:Position="Right" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
    <Border ss:Position="Top" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
   </Borders>
   <Font ss:FontName="Segoe UI" ss:Size="9.5" ss:Color="#1E293B"/>
  </Style>
  <Style ss:ID="SampleDataCell">
   <Alignment ss:Horizontal="Right" ss:Vertical="Center"/>
   <Borders>
    <Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
    <Border ss:Position="Left" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
    <Border ss:Position="Right" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
    <Border ss:Position="Top" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
   </Borders>
   <Font ss:FontName="Segoe UI" ss:Size="9.5" ss:Color="#334155"/>
   <Interior ss:Color="#F0FDFA" ss:Pattern="Solid"/>
  </Style>
  <Style ss:ID="SampleDataCellCenter">
   <Alignment ss:Horizontal="Center" ss:Vertical="Center"/>
   <Borders>
    <Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
    <Border ss:Position="Left" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
    <Border ss:Position="Right" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
    <Border ss:Position="Top" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
   </Borders>
   <Font ss:FontName="Segoe UI" ss:Size="9.5" ss:Color="#334155"/>
   <Interior ss:Color="#F0FDFA" ss:Pattern="Solid"/>
  </Style>
  <Style ss:ID="InstructionsHeader">
   <Alignment ss:Horizontal="Right" ss:Vertical="Center"/>
   <Font ss:FontName="Segoe UI" ss:Size="11" ss:Color="#0F766E" ss:Bold="1"/>
   <Interior ss:Color="#F0FDFA" ss:Pattern="Solid"/>
  </Style>
  <Style ss:ID="InstructionsText">
   <Alignment ss:Horizontal="Right" ss:Vertical="Top" ss:WrapText="1"/>
   <Font ss:FontName="Segoe UI" ss:Size="10" ss:Color="#334155"/>
  </Style>
 </Styles>

 <!-- ════════════════ ورقة 1: بيانات الأطباء ════════════════ -->
 <Worksheet ss:Name="بيانات أطباء اللجان الفرعية">
  <Table ss:DefaultRowHeight="24">
   <Column ss:Width="220"/>
   <Column ss:Width="200"/>
   <Column ss:Width="120"/>
   <Column ss:Width="170"/>
   <Column ss:Width="220"/>
   <Column ss:Width="140"/>
   <Column ss:Width="140"/>
   <Column ss:Width="130"/>
   <Column ss:Width="140"/>
   <Column ss:Width="160"/>
   <Column ss:Width="150"/>
   <Column ss:Width="200"/>
   <Column ss:Width="220"/>

   <!-- ترويسة رئيسية -->
   <Row ss:Height="36">
    <Cell ss:MergeAcross="12" ss:StyleID="TitleHeader">
     <Data ss:Type="String">اللجنة العليا للمسؤولية الطبية وسلامة المريض — نموذج الحصر والرفع الجماعي لأطباء واستشاريي اللجان الفرعية</Data>
    </Cell>
   </Row>
   <Row ss:Height="24">
    <Cell ss:MergeAcross="12" ss:StyleID="SubTitleHeader">
     <Data ss:Type="String">يرجى تسجيل بيانات الأطباء بكل لجنة بدقة (الصفوف الـ 5 الأولى نماذج استرشادية يمكن حذفها أو استبدالها ببياناتكم الفعلية)</Data>
    </Cell>
   </Row>

   <!-- أسماء الأعمدة -->
   <Row ss:Height="32">
    <Cell ss:StyleID="ColHeader"><Data ss:Type="String">اسم اللجنة الفرعية (أو كودها)</Data></Cell>
    <Cell ss:StyleID="ColHeader"><Data ss:Type="String">اسم الطبيب الاستشاري (رباعي/ثلاثي)</Data></Cell>
    <Cell ss:StyleID="ColHeader"><Data ss:Type="String">اللقب العلمي</Data></Cell>
    <Cell ss:StyleID="ColHeader"><Data ss:Type="String">التخصص الطبي المعياري</Data></Cell>
    <Cell ss:StyleID="ColHeader"><Data ss:Type="String">جهة العمل / المستشفى الأصلية</Data></Cell>
    <Cell ss:StyleID="ColHeader"><Data ss:Type="String">الرقم القومي (14 رقماً)</Data></Cell>
    <Cell ss:StyleID="ColHeader"><Data ss:Type="String">رقم الهاتف المحمول (11 رقماً)</Data></Cell>
    <Cell ss:StyleID="ColHeader"><Data ss:Type="String">طريقة الصرف المالي</Data></Cell>
    <Cell ss:StyleID="ColHeader"><Data ss:Type="String">اسم البنك</Data></Cell>
    <Cell ss:StyleID="ColHeader"><Data ss:Type="String">رقم كارت الفيزا / ميزة (16 رقماً)</Data></Cell>
    <Cell ss:StyleID="ColHeader"><Data ss:Type="String">رقم الحساب البنكي</Data></Cell>
    <Cell ss:StyleID="ColHeader"><Data ss:Type="String">رقم الآيبان (IBAN إن وجد)</Data></Cell>
    <Cell ss:StyleID="ColHeader"><Data ss:Type="String">ملاحظات إدارية</Data></Cell>
   </Row>

   <!-- صفوف البيانات التجريبية الاسترشادية -->
   
   <Row ss:Height="25">
    <Cell ss:StyleID="SampleDataCell"><Data ss:Type="String">كلية طب جامعة القاهرة (قصر العيني)</Data></Cell>
    <Cell ss:StyleID="SampleDataCell"><Data ss:Type="String">أحمد محمود حسن إبراهيم</Data></Cell>
    <Cell ss:StyleID="SampleDataCellCenter"><Data ss:Type="String">أستاذ دكتور</Data></Cell>
    <Cell ss:StyleID="SampleDataCellCenter"><Data ss:Type="String">جراحة عامة</Data></Cell>
    <Cell ss:StyleID="SampleDataCell"><Data ss:Type="String">مستشفيات جامعة القاهرة - قصر العيني</Data></Cell>
    <Cell ss:StyleID="SampleDataCellCenter"><Data ss:Type="String">27501010101234</Data></Cell>
    <Cell ss:StyleID="SampleDataCellCenter"><Data ss:Type="String">01012345678</Data></Cell>
    <Cell ss:StyleID="SampleDataCellCenter"><Data ss:Type="String">فيزا مرتبات</Data></Cell>
    <Cell ss:StyleID="SampleDataCell"><Data ss:Type="String">البنك الأهلي المصري</Data></Cell>
    <Cell ss:StyleID="SampleDataCellCenter"><Data ss:Type="String">5248123456789012</Data></Cell>
    <Cell ss:StyleID="SampleDataCellCenter"><Data ss:Type="String"></Data></Cell>
    <Cell ss:StyleID="SampleDataCellCenter"><Data ss:Type="String"></Data></Cell>
    <Cell ss:StyleID="SampleDataCell"><Data ss:Type="String">رئيس قسم الجراحة الأسبق - خبير جراحات المناظير</Data></Cell>
   </Row>
   <Row ss:Height="25">
    <Cell ss:StyleID="SampleDataCell"><Data ss:Type="String">كلية طب جامعة عين شمس</Data></Cell>
    <Cell ss:StyleID="SampleDataCell"><Data ss:Type="String">منى عبد العزيز محمد الدمرداش</Data></Cell>
    <Cell ss:StyleID="SampleDataCellCenter"><Data ss:Type="String">أستاذ دكتور</Data></Cell>
    <Cell ss:StyleID="SampleDataCellCenter"><Data ss:Type="String">التخدير وعلاج الألم</Data></Cell>
    <Cell ss:StyleID="SampleDataCell"><Data ss:Type="String">مستشفى الدمرداش الجامعي</Data></Cell>
    <Cell ss:StyleID="SampleDataCellCenter"><Data ss:Type="String">28205150105678</Data></Cell>
    <Cell ss:StyleID="SampleDataCellCenter"><Data ss:Type="String">01123456789</Data></Cell>
    <Cell ss:StyleID="SampleDataCellCenter"><Data ss:Type="String">حساب بنكي</Data></Cell>
    <Cell ss:StyleID="SampleDataCell"><Data ss:Type="String">بنك مصر</Data></Cell>
    <Cell ss:StyleID="SampleDataCellCenter"><Data ss:Type="String"></Data></Cell>
    <Cell ss:StyleID="SampleDataCellCenter"><Data ss:Type="String">12345678901234</Data></Cell>
    <Cell ss:StyleID="SampleDataCellCenter"><Data ss:Type="String">EG380002000100000012345678901</Data></Cell>
    <Cell ss:StyleID="SampleDataCell"><Data ss:Type="String">استشاري تخدير جراحات القلب المفتوح</Data></Cell>
   </Row>
