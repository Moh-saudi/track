# Development example only. Never commit real production secrets.

DATABASE_URL="postgresql://case_admin:change_me_locally@localhost:5432/case_tracking?schema=public"

# Generate independently:
# openssl rand -base64 48
NEXTAUTH_SECRET="replace_with_random_secret"
NEXTAUTH_URL="http://localhost:3000"

# AES-256-GCM key. Generate: openssl rand -hex 32
FIELD_ENCRYPTION_KEY="replace_with_64_hex_chars"

# JWT session lifetime (8 hours by default)
SESSION_MAX_AGE_SECONDS="28800"

# Login brute-force controls
LOGIN_MAX_FAILURES="5"
LOGIN_RATE_WINDOW_MINUTES="15"
LOGIN_BLOCK_MINUTES="15"

# Persistent document storage.
# Government production example: /srv/medical-liability/uploads
UPLOAD_ROOT="./uploads"
MAX_UPLOAD_MB="25"

# Local document storage is disabled on ephemeral hosting such as Vercel.
# Enable only on the persistent government server.
ENABLE_LOCAL_DOCUMENT_UPLOAD="false"
NEXT_PUBLIC_ENABLE_LOCAL_DOCUMENT_UPLOAD="false"

# Malware scanning: off | optional | required
# Government production must use required.
MALWARE_SCAN_MODE="off"
CLAMAV_COMMAND="clamdscan"
CLAMAV_TIMEOUT_MS="60000"

# Reference seed: set true only during the controlled first initialization.
ALLOW_REFERENCE_SEED="false"

# One-time initial administrator bootstrap. Remove the password immediately after use.
INITIAL_ADMIN_EMAIL=""
INITIAL_ADMIN_PASSWORD=""
INITIAL_ADMIN_NAME="مدير المنظومة"
INITIAL_ADMIN_EMPLOYER="رئاسة مجلس الوزراء"
