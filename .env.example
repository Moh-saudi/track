# انسخ هذا الملف إلى .env وعدّل القيم قبل التشغيل محليًا
# Copy this file to .env and edit the values before running locally

# اتصال قاعدة بيانات PostgreSQL المحلية (راجع docker-compose.yml)
DATABASE_URL="postgresql://case_admin:change_me_locally@localhost:5432/case_tracking?schema=public"

# مفتاح سري لتوقيع جلسات NextAuth — ولّده بالأمر: openssl rand -base64 32
NEXTAUTH_SECRET="change_me_generate_a_random_secret"
NEXTAUTH_URL="http://localhost:3000"

# مفتاح تشفير إضافي للحقول الحساسة (الرقم القومي) — ولّده بنفس الطريقة
FIELD_ENCRYPTION_KEY="change_me_32_bytes_hex_or_base64"
