# Example only - replace domain, certificate paths and upstream according to government infrastructure.

limit_req_zone $binary_remote_addr zone=auth_limit:10m rate=5r/m;

upstream medical_liability_app {
    server 127.0.0.1:3000;
    keepalive 32;
}

server {
    listen 80;
    server_name medical-liability.example.gov.eg;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name medical-liability.example.gov.eg;

    ssl_certificate     /etc/pki/tls/certs/medical-liability.crt;
    ssl_certificate_key /etc/pki/tls/private/medical-liability.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:20m;

    server_tokens off;
    client_max_body_size 30m;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;

    location = /api/auth/callback/credentials {
        limit_req zone=auth_limit burst=5 nodelay;
        proxy_pass http://medical_liability_app;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    location / {
        proxy_pass http://medical_liability_app;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
        proxy_request_buffering on;
    }

    # Never expose application document storage as a static alias.
    location ~ /\. {
        deny all;
    }
}
